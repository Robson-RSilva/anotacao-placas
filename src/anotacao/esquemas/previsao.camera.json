          "exclusiveMinimum": 0.5,
          "title": "Hfov Graus",
          "type": "number"
        },
        "k1": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "K1",
          "type": "number"
        },
        "pan": {
          "title": "Pan",
          "type": "number"
        },
        "roll": {
          "maximum": 45,
          "minimum": -45,
          "title": "Roll",
          "type": "number"
        },
        "tilt": {
          "maximum": 90,
          "minimum": -90,
          "title": "Tilt",
          "type": "number"
        }
      },
      "required": [
        "hfov_graus",
        "pan",
        "tilt",
        "roll",
        "C"
      ],
      "title": "CameraRotulo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "camera": {
      "anyOf": [
        {
          "$ref": "#/$defs/CameraRotulo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confianca": {
