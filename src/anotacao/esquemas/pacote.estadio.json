{
  "$defs": {
    "CameraRegistro": {
      "additionalProperties": false,
      "properties": {
        "T": {
          "description": "posição do tripé (m), no referencial do campo",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "T",
          "type": "array"
        },
        "nome": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Nome",
          "type": "string"
        },
        "tipo": {
          "enum": [
            "principal",
            "16m",
            "fundo",
            "reversa",
            "baixa",
            "tatica",
            "outra"
          ],
          "title": "Tipo",
          "type": "string"
        }
      },
      "required": [
        "nome",
        "tipo",
        "T"
      ],
      "title": "CameraRegistro",
      "type": "object"
    },
    "CampoPacote": {
      "additionalProperties": false,
      "properties": {
        "comprimento": {
          "default": 105.0,
          "description": "metros, linha de fundo a linha de fundo",
          "exclusiveMaximum": 130,
          "exclusiveMinimum": 80,
          "title": "Comprimento",
          "type": "number"
        },
        "largura": {
          "default": 68.0,
          "description": "metros, lateral a lateral",
          "exclusiveMaximum": 100,
          "exclusiveMinimum": 40,
          "title": "Largura",
          "type": "number"
        }
      },
      "title": "CampoPacote",
      "type": "object"
    },
    "PlacaPacote": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "lado": {
          "enum": [
            "cab",
            "opo",
            "esq",
            "dir"
          ],
          "title": "Lado",
          "type": "string"
        },
        "patrocinador": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patrocinador"
        },
        "tipo": {
          "enum": [
            "estatica",
            "led"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "vertices": {
          "description": "BL, BR, TR, TL, vistos de frente",
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Vertices",
          "type": "array"
        }
      },
      "required": [
        "id",
        "tipo",
        "lado",
        "vertices"
      ],
      "title": "PlacaPacote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cameras": {
      "items": {
        "$ref": "#/$defs/CameraRegistro"
      },
      "minItems": 1,
      "title": "Cameras",
      "type": "array"
    },
    "campo": {
      "$ref": "#/$defs/CampoPacote"
    },
    "estadio": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Estadio",
      "type": "string"
    },
    "formato": {
      "const": "pacote.estadio/1",
      "default": "pacote.estadio/1",
      "title": "Formato",
      "type": "string"
    },
    "nome": {
      "title": "Nome",
      "type": "string"
    },
    "placas": {
      "items": {
        "$ref": "#/$defs/PlacaPacote"
      },
      "title": "Placas",
      "type": "array"
    },
    "versao": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Versao",
      "type": "string"
    }
  },
  "required": [
    "estadio",
    "versao",
    "nome",
    "campo",
    "placas",
    "cameras"
  ],
  "title": "PacoteEstadio",
  "type": "object"
}
