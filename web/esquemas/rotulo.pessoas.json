{
  "$defs": {
    "PartiuDe": {
      "additionalProperties": false,
      "properties": {
        "fonte": {
          "enum": [
            "nenhuma",
            "modelo",
            "rotulo_anterior",
            "rotulo_revisado"
          ],
          "title": "Fonte",
          "type": "string"
        },
        "referencia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referencia"
        },
        "versao": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Versao"
        }
      },
      "required": [
        "fonte"
      ],
      "title": "PartiuDe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A máscara das pessoas do quadro (PNG ao lado, com o mesmo nome do rótulo: 1 onde há pessoa, 0 no\nresto). Pinta-se toda pessoa no gramado e em volta dele, do lado de dentro das placas — jogadores,\ngoleiros, árbitros, gandulas, fotógrafos, comissão técnica, seguranças —, e não a torcida nem as\nsombras. Sem nenhuma pessoa, a máscara é toda 0. Imagem descartada não leva máscara.",
  "properties": {
    "altura": {
      "description": "altura da imagem (px)",
      "exclusiveMinimum": 0,
      "title": "Altura",
      "type": "integer"
    },
    "anotador": {
      "pattern": "^[A-Z][A-Z0-9]{1,9}$",
      "title": "Anotador",
      "type": "string"
    },
    "comentario": {
      "default": "",
      "title": "Comentario",
      "type": "string"
    },
    "corrige": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "arquivo do rótulo que esta versão corrige (revisão cruzada)",
      "title": "Corrige"
    },
    "criado_em": {
      "format": "date-time",
      "title": "Criado Em",
      "type": "string"
    },
    "ferramenta": {
      "title": "Ferramenta",
      "type": "string"
    },
    "formato": {
      "const": "rotulo.pessoas/1",
      "default": "rotulo.pessoas/1",
      "title": "Formato",
      "type": "string"
    },
    "largura": {
      "description": "largura da imagem (px)",
      "exclusiveMinimum": 0,
      "title": "Largura",
      "type": "integer"
    },
    "manual": {
      "title": "Manual",
      "type": "string"
    },
    "mascara": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "o PNG da máscara, ao lado (o mesmo nome, com .png)",
      "title": "Mascara"
    },
    "motivo_descarte": {
      "anyOf": [
        {
          "enum": [
            "transicao",
            "borrao",
            "grafismo",
            "outro"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Motivo Descarte"
    },
    "partida": {
      "description": "ID da partida, ou 'gabarito'",
      "title": "Partida",
      "type": "string"
    },
    "partiu_de": {
      "$ref": "#/$defs/PartiuDe"
    },
    "pixels": {
      "default": 0,
      "description": "pixels pintados (pessoa) na máscara",
      "minimum": 0,
      "title": "Pixels",
      "type": "integer"
    },
    "quadro": {
      "description": "ID do quadro (t + PTS em ms) ou do item do gabarito (g1001)",
      "title": "Quadro",
      "type": "string"
    },
    "segundos_ativos": {
      "minimum": 0,
      "title": "Segundos Ativos",
      "type": "number"
    },
    "situacao": {
      "enum": [
        "ok",
        "descartada"
      ],
      "title": "Situacao",
      "type": "string"
    },
    "versao": {
      "minimum": 1,
      "title": "Versao",
      "type": "integer"
    }
  },
  "required": [
    "partida",
    "quadro",
    "anotador",
    "versao",
    "ferramenta",
    "manual",
    "criado_em",
    "segundos_ativos",
    "largura",
    "altura",
    "partiu_de",
    "situacao"
  ],
  "title": "RotuloPessoas",
  "type": "object"
}
