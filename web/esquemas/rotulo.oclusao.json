{
  "$defs": {
    "CameraRotulo": {
      "additionalProperties": false,
      "properties": {
        "C": {
          "description": "centro óptico (m)",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "C",
          "type": "array"
        },
        "hfov_graus": {
          "description": "campo de visão horizontal",
          "exclusiveMaximum": 150,
          "exclusiveMinimum": 0.5,
          "title": "Hfov Graus",
          "type": "number"
        },
        "k1": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "K1",
          "type": "number"
        },
        "pan": {
          "title": "Pan",
          "type": "number"
        },
        "roll": {
          "maximum": 45,
          "minimum": -45,
          "title": "Roll",
          "type": "number"
        },
        "tilt": {
          "maximum": 90,
          "minimum": -90,
          "title": "Tilt",
          "type": "number"
        }
      },
      "required": [
        "hfov_graus",
        "pan",
        "tilt",
        "roll",
        "C"
      ],
      "title": "CameraRotulo",
      "type": "object"
    },
    "CampoPacote": {
      "additionalProperties": false,
      "properties": {
        "comprimento": {
          "default": 105.0,
          "description": "metros, linha de fundo a linha de fundo",
          "exclusiveMaximum": 130,
          "exclusiveMinimum": 80,
          "title": "Comprimento",
          "type": "number"
        },
        "largura": {
          "default": 68.0,
          "description": "metros, lateral a lateral",
          "exclusiveMaximum": 100,
          "exclusiveMinimum": 40,
          "title": "Largura",
          "type": "number"
        }
      },
      "title": "CampoPacote",
      "type": "object"
    },
    "Faixa": {
      "additionalProperties": false,
      "properties": {
        "altura": {
          "description": "m, do gramado ao topo das placas",
          "maximum": 5,
          "minimum": 0.2,
          "title": "Altura",
          "type": "number"
        },
        "comprimento": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "m, a faixa inteira, centrada no meio do lado; sem ele, de canto a canto",
          "title": "Comprimento"
        },
        "distancia": {
          "description": "m, da linha (lateral ou de fundo) até a frente das placas",
          "maximum": 30,
          "minimum": 0.5,
          "title": "Distancia",
          "type": "number"
        },
        "ligada": {
          "default": true,
          "description": "há placas desses lados",
          "title": "Ligada",
          "type": "boolean"
        },
        "vao": {
          "default": 0.0,
          "description": "m, um vão sem placas no meio da faixa (atrás do gol, por exemplo)",
          "maximum": 100,
          "minimum": 0,
          "title": "Vao",
          "type": "number"
        }
      },
      "required": [
        "distancia",
        "altura"
      ],
      "title": "Faixa",
      "type": "object"
    },
    "Faixas": {
      "additionalProperties": false,
      "description": "As faixas de placas do campo genérico: as duas laterais com as mesmas medidas, e os dois fundos.",
      "properties": {
        "fundos": {
          "$ref": "#/$defs/Faixa"
        },
        "laterais": {
          "$ref": "#/$defs/Faixa"
        }
      },
      "required": [
        "laterais",
        "fundos"
      ],
      "title": "Faixas",
      "type": "object"
    },
    "PartiuDeOclusao": {
      "additionalProperties": false,
      "properties": {
        "fonte": {
          "enum": [
            "nenhuma",
            "modelo",
            "rotulo_anterior",
            "rotulo_revisado"
          ],
          "title": "Fonte",
          "type": "string"
        },
        "referencia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referencia"
        },
        "versao": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Versao"
        }
      },
      "required": [
        "fonte"
      ],
      "title": "PartiuDeOclusao",
      "type": "object"
    },
    "PlacaOclusao": {
      "additionalProperties": false,
      "description": "O que a máscara diz de uma placa, em pixels do quadro.",
      "properties": {
        "altura_ref_px": {
          "description": "altura da placa na imagem (px, ref. 960)",
          "minimum": 0,
          "title": "Altura Ref Px",
          "type": "number"
        },
        "area_px": {
          "description": "pixels do polígono da placa dentro da imagem",
          "minimum": 0,
          "title": "Area Px",
          "type": "integer"
        },
        "bola_px": {
          "minimum": 0,
          "title": "Bola Px",
          "type": "integer"
        },
        "grafismo_px": {
          "minimum": 0,
          "title": "Grafismo Px",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "lado": {
          "anyOf": [
            {
              "enum": [
                "cab",
                "opo",
                "esq",
                "dir"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lado"
        },
        "livre_frac": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(livre + rede) / (área − não é placa); nenhuma nas pequenas demais",
          "title": "Livre Frac"
        },
        "livre_px": {
          "minimum": 0,
          "title": "Livre Px",
          "type": "integer"
        },
        "nao_placa_px": {
          "minimum": 0,
          "title": "Nao Placa Px",
          "type": "integer"
        },
        "objeto_px": {
          "minimum": 0,
          "title": "Objeto Px",
          "type": "integer"
        },
        "outra_placa_px": {
          "description": "desses, os cobertos por uma placa mais perto",
          "minimum": 0,
          "title": "Outra Placa Px",
          "type": "integer"
        },
        "pequena": {
          "description": "mais baixa que 10 px (ref. 960): não se pinta",
          "title": "Pequena",
          "type": "boolean"
        },
        "pessoa_px": {
          "minimum": 0,
          "title": "Pessoa Px",
          "type": "integer"
        },
        "rede_px": {
          "minimum": 0,
          "title": "Rede Px",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "area_px",
        "outra_placa_px",
        "livre_px",
        "pessoa_px",
        "bola_px",
        "rede_px",
        "grafismo_px",
        "objeto_px",
        "nao_placa_px",
        "altura_ref_px",
        "pequena"
      ],
      "title": "PlacaOclusao",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A oclusão nas placas de um quadro: a máscara (PNG ao lado, com o mesmo nome) e o que ela diz\nde cada placa. As placas saem da câmera aprovada do quadro e das faixas, do pacote ou do item.",
  "properties": {
    "altura": {
      "exclusiveMinimum": 0,
      "title": "Altura",
      "type": "integer"
    },
    "anotador": {
      "pattern": "^[A-Z][A-Z0-9]{1,9}$",
      "title": "Anotador",
      "type": "string"
    },
    "camera": {
      "$ref": "#/$defs/CameraRotulo",
      "description": "a câmera que desenhou as placas"
    },
    "camera_de": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "rótulo de câmera aprovado de onde veio a câmera (no gabarito, nenhum)",
      "title": "Camera De"
    },
    "campo": {
      "anyOf": [
        {
          "$ref": "#/$defs/CampoPacote"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "medidas do campo da câmera (as faixas ficam a uma distância das linhas)"
    },
    "comentario": {
      "default": "",
      "title": "Comentario",
      "type": "string"
    },
    "corrige": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "arquivo do rótulo que esta versão corrige (revisão cruzada)",
      "title": "Corrige"
    },
    "criado_em": {
      "format": "date-time",
      "title": "Criado Em",
      "type": "string"
    },
    "faixas": {
      "anyOf": [
        {
          "$ref": "#/$defs/Faixas"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ferramenta": {
      "title": "Ferramenta",
      "type": "string"
    },
    "formato": {
      "const": "rotulo.oclusao/1",
      "default": "rotulo.oclusao/1",
      "title": "Formato",
      "type": "string"
    },
    "largura": {
      "exclusiveMinimum": 0,
      "title": "Largura",
      "type": "integer"
    },
    "manual": {
      "title": "Manual",
      "type": "string"
    },
    "mascara": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "o PNG da máscara, ao lado (o mesmo nome, com .png)",
      "title": "Mascara"
    },
    "pacote": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/pacote-\\d+\\.\\d+$",
      "title": "Pacote",
      "type": "string"
    },
    "partida": {
      "description": "ID da partida, ou 'gabarito'",
      "title": "Partida",
      "type": "string"
    },
    "partiu_de": {
      "$ref": "#/$defs/PartiuDeOclusao"
    },
    "placas": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlacaOclusao"
      },
      "title": "Placas",
      "type": "array"
    },
    "placas_de": {
      "enum": [
        "faixas",
        "pacote",
        "gabarito"
      ],
      "title": "Placas De",
      "type": "string"
    },
    "quadro": {
      "description": "ID do quadro (t + PTS em ms) ou do item do gabarito (g0401)",
      "title": "Quadro",
      "type": "string"
    },
    "segundos_ativos": {
      "minimum": 0,
      "title": "Segundos Ativos",
      "type": "number"
    },
    "situacao": {
      "enum": [
        "ok",
        "sem_placas",
        "camera_errada",
        "duvida"
      ],
      "title": "Situacao",
      "type": "string"
    },
    "versao": {
      "minimum": 1,
      "title": "Versao",
      "type": "integer"
    }
  },
  "required": [
    "partida",
    "pacote",
    "quadro",
    "anotador",
    "versao",
    "ferramenta",
    "manual",
    "criado_em",
    "segundos_ativos",
    "largura",
    "altura",
    "camera",
    "placas_de",
    "partiu_de",
    "situacao"
  ],
  "title": "RotuloOclusao",
  "type": "object"
}
