{
  "$defs": {
    "PartiuDe": {
      "additionalProperties": false,
      "properties": {
        "fonte": {
          "enum": [
            "nenhuma",
            "modelo",
            "rotulo_anterior",
            "rotulo_revisado"
          ],
          "title": "Fonte",
          "type": "string"
        },
        "referencia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referencia"
        },
        "versao": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Versao"
        }
      },
      "required": [
        "fonte"
      ],
      "title": "PartiuDe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "O que está na frente da placa, pintado no recorte dela (PNG ao lado, com o mesmo nome do rótulo:\n1 onde algo cobre a placa, 0 no resto e fora da região da placa). Pinta-se tudo o que esconde a\nplaca de quem assiste — gente, bola, trave, outra placa, câmera, bandeira, grafismo da emissora —,\ne não o próprio anúncio, sombra, reflexo nem o que deixa ver a placa através (a rede). Sem nada na\nfrente, a máscara é toda 0. Recorte descartado não leva máscara.",
  "properties": {
    "altura": {
      "description": "altura da imagem (px)",
      "exclusiveMinimum": 0,
      "title": "Altura",
      "type": "integer"
    },
    "anotador": {
      "pattern": "^[A-Z][A-Z0-9]{1,9}$",
      "title": "Anotador",
      "type": "string"
    },
    "comentario": {
      "default": "",
      "title": "Comentario",
      "type": "string"
    },
    "corrige": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "arquivo do rótulo que esta versão corrige (revisão cruzada)",
      "title": "Corrige"
    },
    "criado_em": {
      "format": "date-time",
      "title": "Criado Em",
      "type": "string"
    },
    "ferramenta": {
      "title": "Ferramenta",
      "type": "string"
    },
    "formato": {
      "const": "rotulo.placas/1",
      "default": "rotulo.placas/1",
      "title": "Formato",
      "type": "string"
    },
    "largura": {
      "description": "largura da imagem (px)",
      "exclusiveMinimum": 0,
      "title": "Largura",
      "type": "integer"
    },
    "manual": {
      "title": "Manual",
      "type": "string"
    },
    "mascara": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "o PNG da máscara, ao lado (o mesmo nome, com .png)",
      "title": "Mascara"
    },
    "motivo_descarte": {
      "anyOf": [
        {
          "enum": [
            "placa_fora_do_lugar",
            "transicao",
            "borrao",
            "outro"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Motivo Descarte"
    },
    "partida": {
      "description": "ID da partida, ou 'gabarito'",
      "title": "Partida",
      "type": "string"
    },
    "partiu_de": {
      "$ref": "#/$defs/PartiuDe"
    },
    "pixels": {
      "default": 0,
      "description": "pixels pintados (algo na frente da placa) na máscara",
      "minimum": 0,
      "title": "Pixels",
      "type": "integer"
    },
    "recorte": {
      "description": "ID do recorte (<quadro>_<placa>) ou do item do gabarito (g4001)",
      "maxLength": 48,
      "title": "Recorte",
      "type": "string"
    },
    "segundos_ativos": {
      "minimum": 0,
      "title": "Segundos Ativos",
      "type": "number"
    },
    "situacao": {
      "enum": [
        "ok",
        "descartada"
      ],
      "title": "Situacao",
      "type": "string"
    },
    "versao": {
      "minimum": 1,
      "title": "Versao",
      "type": "integer"
    }
  },
  "required": [
    "partida",
    "anotador",
    "versao",
    "ferramenta",
    "manual",
    "criado_em",
    "segundos_ativos",
    "largura",
    "altura",
    "partiu_de",
    "situacao",
    "recorte"
  ],
  "title": "RotuloPlacas",
  "type": "object"
}
